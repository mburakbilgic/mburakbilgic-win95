# Content database (SQLite). Defaults to .data/site.db relative to the working dir.
NUXT_DB_PATH=

# Photo gallery — SEED ONLY. Read once when the database is empty to fill
# C:\MBURAKBILGIC\PHOTOS; afterwards photos live in the database and these
# can be removed.
NUXT_PUBLIC_PHOTOS_GH_0=
NUXT_PUBLIC_PHOTOS_GH_1=
NUXT_PUBLIC_PHOTOS_GH_2=
NUXT_PUBLIC_PHOTOS_GH_3=
NUXT_PUBLIC_PHOTOS_GLADIO_0=
NUXT_PUBLIC_PHOTOS_GLADIO_1=
NUXT_PUBLIC_PHOTOS_INSTRACTORS_0=

# Résumé — PDF download link and Google Drive preview link
NUXT_PUBLIC_RESUME_PDF_URL=
NUXT_PUBLIC_RESUME_PREVIEW_URL=

# Mail — server-only SMTP settings used by POST /api/mail (never NUXT_PUBLIC_).
# Google Workspace: smtp.gmail.com / 465 with an App Password
# (myaccount.google.com → Security → App passwords; 2-Step Verification required).
NUXT_MAIL_SMTP_HOST=smtp.gmail.com
NUXT_MAIL_SMTP_PORT=465
NUXT_MAIL_SMTP_USER=
NUXT_MAIL_SMTP_PASS=
# Inbox that receives contact messages (defaults to NUXT_MAIL_SMTP_USER when empty)
NUXT_MAIL_TO=

# Production listen address (read by the Nitro server). On the VPS bind to
# localhost so only Nginx can reach the app. Defaults: all interfaces, 3000.
# NITRO_HOST=127.0.0.1
# NITRO_PORT=3000

# Admin (DOS shell LOGIN) — scrypt hash, generate with: npm run admin:hash
# Never put the plain password here. Sessions last 2 hours.
NUXT_ADMIN_PASSWORD_HASH=

# Contact form anti-spam — HMAC secret for the form token (server-only, 32+ random chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When empty a per-process secret is used and open mail forms expire on restart.
NUXT_MAIL_FORM_SECRET=
