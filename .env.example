# Photo gallery — public image URLs served from your CDN / bucket
NUXT_PUBLIC_PHOTOS_GH_0=
NUXT_PUBLIC_PHOTOS_GH_1=
NUXT_PUBLIC_PHOTOS_GH_2=
NUXT_PUBLIC_PHOTOS_GH_3=
NUXT_PUBLIC_PHOTOS_GLADIO_0=
NUXT_PUBLIC_PHOTOS_GLADIO_1=
NUXT_PUBLIC_PHOTOS_INSTRACTORS_0=

# Résumé — PDF download link and Google Drive preview link
NUXT_PUBLIC_RESUME_PDF_URL=
NUXT_PUBLIC_RESUME_PREVIEW_URL=

# Mail — Google Forms endpoint the mail window POSTs to.
# Create a Google Form with three fields (Subject, Sender, Content) and paste
# the form's formResponse URL and the three `entry.*` field IDs here.
NUXT_PUBLIC_MAIL_FORM_ACTION=
NUXT_PUBLIC_MAIL_ENTRY_SUBJECT=
NUXT_PUBLIC_MAIL_ENTRY_SENDER=
NUXT_PUBLIC_MAIL_ENTRY_CONTENT=
